# syntax=docker/dockerfile:1
# Staging tools image: the S7 replay driver (tools/s7) and the throttle probe (tools/probe). Not part of the service image;
# never deployed to production. Build from the REPOSITORY ROOT (the context needs src/, tools/ and deploy/):
#   docker build -f deploy/staging/Dockerfile.tools -t semigraph-tools .
# What is inside: the runtime stage of the main Dockerfile WITHOUT its model stage. S7 measures the database, not the
# embedder: the question vectors are computed beforehand (tools/s7/vectors.py) and read from tools/s7/data, so no embedding model
# and no onnxruntime weights are needed here. The image installs the pinned serving requirements (deploy/requirements-serve.txt:
# the neo4j driver and the semigraph modules the service itself runs), the semigraph package, tools/s7, tools/probe and the
# 300-question pool. No secret is baked in; the database password is passed to the command that needs it. No PDF library.
#
# PIN (open, needs network): the base image is the tag the main Dockerfile uses. Replace PYTHON_IMAGE with
# python:3.13-slim@sha256:<digest> (docker buildx imagetools inspect python:3.13-slim) before the first paid staging window.
ARG PYTHON_IMAGE=python:3.13-slim
FROM ${PYTHON_IMAGE}
# LiteLLM (imported through the service's store module) fetches its price table at import unless told to use its bundled copy:
# the tools machine makes no call it was not asked to make.
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 LITELLM_LOCAL_MODEL_COST_MAP=True
COPY --from=ghcr.io/astral-sh/uv:0.11.20 /uv /bin/uv
WORKDIR /srv
COPY deploy/requirements-serve.txt deploy/
RUN uv pip install --system --no-cache -r deploy/requirements-serve.txt
COPY pyproject.toml README.md ./
COPY src/ src/
RUN uv pip install --system --no-cache --no-deps .
COPY tools/__init__.py tools/__init__.py
COPY tools/s7 tools/s7
COPY tools/probe tools/probe
COPY tools/loadtest/pool.json tools/loadtest/pool.json
# Never run as root; /out is where the runs write their raw files.
RUN useradd --create-home --shell /usr/sbin/nologin app && mkdir -p /out && chown -R app:app /srv /out
USER app
# Idle until a run is started with `flyctl ssh console -C "python -m tools.s7.replay ..."` (or tools.probe.burn).
CMD ["sleep", "infinity"]
