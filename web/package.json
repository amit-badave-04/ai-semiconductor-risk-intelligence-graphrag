{
  "name": "semigraph-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
