# Copy to .env and fill in. Never commit .env.

# --- LLM (LiteLLM routes by model prefix; Claude Sonnet is the project default) ---
ANTHROPIC_API_KEY=sk-ant-...
# Default extraction/answering model (LiteLLM format)
LLM_MODEL=anthropic/claude-sonnet-5

# --- Neo4j Desktop local instance ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- SEC EDGAR (SEC requires a declared identity: "Name email") ---
SEC_USER_AGENT=Amit Badave amit11badave.ab@gmail.com

# --- Embeddings (local, 1024-dim to match the graph's vector indexes) ---
# Qwen3-Embedding-0.6B: best-in-class small embedder (2026), 32k context, Apache-2.0.
# Fallback known-good: BAAI/bge-large-en-v1.5 (English-only, 512-token truncation).
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Embedding backend (query-time) ---
# local  = sentence-transformers + torch (pipeline default)
# onnx   = torch-free onnxruntime over the quantized export (what the web service ships);
#          build once: python scripts/build_onnx_embedder.py
# remote = any OpenAI-compatible /embeddings endpoint serving the SAME model
EMBEDDING_BACKEND=local
#ONNX_MODEL_PATH=models/qwen3-embedding-0.6b-q8/model_q8.onnx
#EMBEDDING_API_BASE=https://api.deepinfra.com/v1/openai
#EMBEDDING_API_KEY=

# --- Web service (semigraph.serve) — production values live in .env.fly (git-ignored) ---
ENVIRONMENT=development
#APP_BASE_URL=https://semigraph.fly.dev
#ADMIN_TOKEN=            # X-Admin-Token for /api/admin/policy (scripts/kill_switch.py)
#MAX_QUERIES_PER_DAY=150 # global ceiling on paid answers per UTC day (0 = unlimited)
#RATE_LIMIT_QUESTIONS=5  # per client address ...
#RATE_LIMIT_WINDOW_SECONDS=600
#LLM_ANSWER_MAX_TOKENS=2400
#TURNSTILE_SITE_KEY=     # optional Cloudflare Turnstile bot gate
#TURNSTILE_SECRET_KEY=
