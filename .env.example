# Copy to .env and fill in. Never commit .env.

# --- LLM (LiteLLM routes by model prefix; Claude Sonnet is the project default) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional providers for the cheaper-model bake-off (LiteLLM reads these from the environment; leave blank if unused).
# Use ONE US-hosted open-weight host: DeepInfra here, or FIREWORKS_AI_API_KEY / TOGETHERAI_API_KEY / OPENROUTER_API_KEY.
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#DEEPINFRA_API_KEY=
# LLM_MODEL is for EXTRACTION and the eval JUDGES only (schema-sensitive: it never follows the answering model).
LLM_MODEL=anthropic/claude-sonnet-5
# The model that DRAFTS live answers in the web service (LiteLLM format). The code default is Sonnet, so a local run
# is Sonnet; production (fly.toml [env]) sets openai/gpt-6-luna, which needs OPENAI_API_KEY above.
#ANSWER_MODEL=anthropic/claude-sonnet-5
# The stronger model a draft is re-answered by when the answer checks reject it, and that answers change-over-time
# questions directly. Empty = no escalation: ANSWER_MODEL streams every answer live (the Sonnet-only rollback).
#ESCALATION_MODEL=anthropic/claude-sonnet-5
# The cheap model that adjudicates ONLY the risk items the text-matching left uncertain or removed (`semigraph align-items --adjudicate`,
# ~$0.01 for the whole lake; off unless the flag is given). It can only rescue an item (find its verbatim counterpart); it can never invent a removal.
# The same model also settles the passage layer's lexical-band sentences (`semigraph align-items --adjudicate-passages`, cents; every answer is
# cached in data/interim/risk_alignment/passage_adjudications.jsonl and replayed by every later run). Try `semigraph align-items --probe-adjudicator` first.
#ADJUDICATION_MODEL=openai/gpt-6-luna

# --- Neo4j Desktop local instance ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- SEC EDGAR (SEC requires a declared identity: "Name email") ---
SEC_USER_AGENT=Amit Badave amit11badave.ab@gmail.com

# --- Embeddings (local, 1024-dim to match the graph's vector indexes) ---
# Qwen3-Embedding-0.6B: best-in-class small embedder (2026), 32k context, Apache-2.0.
# Fallback known-good: BAAI/bge-large-en-v1.5 (English-only, 512-token truncation).
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Embedding backend (query-time) ---
# local  = sentence-transformers + torch (pipeline default)
# onnx   = torch-free onnxruntime over the quantized export (what the web service ships);
#          build once: python scripts/build_onnx_embedder.py
# remote = any OpenAI-compatible /embeddings endpoint serving the SAME model
EMBEDDING_BACKEND=local
#ONNX_MODEL_PATH=models/qwen3-embedding-0.6b-q8/model_q8.onnx
#EMBEDDING_API_BASE=https://api.deepinfra.com/v1/openai
#EMBEDDING_API_KEY=

# --- Web service (semigraph.serve) — production values live in .env.fly (git-ignored) ---
ENVIRONMENT=development
#APP_BASE_URL=https://semigraph.fly.dev
#ADMIN_TOKEN=            # X-Admin-Token for /api/admin/policy (scripts/kill_switch.py)
#MAX_QUERIES_PER_DAY=150 # global ceiling on paid answers per UTC day (0 = unlimited)
#RATE_LIMIT_QUESTIONS=5  # per client address ...
#RATE_LIMIT_WINDOW_SECONDS=600
#LLM_ANSWER_MAX_TOKENS=2400
#TURNSTILE_SITE_KEY=     # optional Cloudflare Turnstile bot gate
#TURNSTILE_SECRET_KEY=
#TURNSTILE_REQUIRED=true  # fail closed once the widget exists (docs/RUNBOOK.md)
#READ_RATE_LIMIT_PER_MINUTE=120

# --- Agent (semigraph.agent, docs/v2/M3_AGENT_PLAN.md): an OPT-IN retrieval planner, strategy "agent". Off by default. ---
# Needs the `agent` extra (langgraph) in the image: uv sync --extra agent. The fixed hybrid path stays the default and the fallback.
#AGENT_ENABLED=false
#AGENT_PLANNER_MODEL=openai/gpt-6-luna    # plans the tool calls only; the answer still comes from ANSWER_MODEL / ESCALATION_MODEL
#AGENT_MAX_TOOL_CALLS=4
#AGENT_MAX_MODEL_CALLS=3
#AGENT_TIME_BUDGET_S=25                    # on expiry (or any planner failure) the plain hybrid retrieval answers

# --- Langfuse tracing (semigraph.serve.tracing): OFF unless all three are set AND the langfuse package is installed ---
# pip install "langfuse>=4.14,<5". Sampled, fail-open; a trace carries lengths, counts, ids, tool and model names, tokens, cost and latency,
# never the question, the answer, an address, a header or a key. Needs the owner's sign-off (the page then shows a privacy line).
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_HOST=
#LANGFUSE_SAMPLE_RATE=0.1
#LANGFUSE_HASH_SALT=     # empty = a random salt per process; set it to group repeated questions across restarts
