# Copy to .env and fill in. Never commit .env.

# --- LLM (LiteLLM routes by model prefix; Claude Sonnet is the project default) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional providers for the cheaper-model bake-off (LiteLLM reads these from the environment; leave blank if unused).
# Use ONE US-hosted open-weight host: DeepInfra here, or FIREWORKS_AI_API_KEY / TOGETHERAI_API_KEY / OPENROUTER_API_KEY.
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#DEEPINFRA_API_KEY=
# LLM_MODEL is for EXTRACTION and the eval JUDGES only (schema-sensitive: it never follows the answering model).
LLM_MODEL=anthropic/claude-sonnet-5
# The model that DRAFTS live answers in the web service (LiteLLM format). The code default is Sonnet, so a local run
# is Sonnet; production (fly.toml [env]) sets openai/gpt-6-luna, which needs OPENAI_API_KEY above.
#ANSWER_MODEL=anthropic/claude-sonnet-5
# The stronger model a draft is re-answered by when the answer checks reject it, and that answers change-over-time
# questions directly. Empty = no escalation: ANSWER_MODEL streams every answer live (the Sonnet-only rollback).
#ESCALATION_MODEL=anthropic/claude-sonnet-5
# The cheap model that adjudicates ONLY the risk items the text-matching left uncertain or removed (`semigraph align-items --adjudicate`,
# ~$0.01 for the whole lake; off unless the flag is given). It can only rescue an item (find its verbatim counterpart); it can never invent a removal.
# The same model also settles the passage layer's lexical-band sentences (`semigraph align-items --adjudicate-passages`, cents; every answer is
# cached in data/interim/risk_alignment/passage_adjudications.jsonl and replayed by every later run). Try `semigraph align-items --probe-adjudicator` first.
#ADJUDICATION_MODEL=openai/gpt-6-luna

# --- Neo4j Desktop local instance ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- SEC EDGAR (SEC requires a declared identity: "Name email") ---
# Production sets it as a Fly SECRET (scripts/push_fly_secrets.py), never in fly.toml: the value names a real person.
SEC_USER_AGENT=Your Name you@example.com

# --- Embeddings (local, 1024-dim to match the graph's vector indexes) ---
# Qwen3-Embedding-0.6B: best-in-class small embedder (2026), 32k context, Apache-2.0.
# Fallback known-good: BAAI/bge-large-en-v1.5 (English-only, 512-token truncation).
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Embedding backend (query-time) ---
# local  = sentence-transformers + torch (pipeline default)
# onnx   = torch-free onnxruntime over the quantized export (what the web service ships);
#          build once: python scripts/build_onnx_embedder.py
# remote = any OpenAI-compatible /embeddings endpoint serving the SAME model
EMBEDDING_BACKEND=local
#ONNX_MODEL_PATH=models/qwen3-embedding-0.6b-q8/model_q8.onnx
#EMBEDDING_API_BASE=https://api.deepinfra.com/v1/openai
#EMBEDDING_API_KEY=

# --- Web service (semigraph.serve) — production values live in .env.fly (git-ignored) ---
# ENVIRONMENT is trimmed and lower-cased. On Fly it must match the app (FLY_APP_NAME, which Fly sets: semigraph = production,
# semigraph-stg = staging) or the service refuses to start; leave FLY_APP_NAME unset locally.
ENVIRONMENT=development
#APP_BASE_URL=https://semigraph.fly.dev
#ADMIN_TOKEN=            # X-Admin-Token for /api/admin/policy (scripts/kill_switch.py); production: empty (admin routes off) or 32+ characters
#MAX_QUERIES_PER_DAY=150 # global ceiling on paid answers per UTC day (0 = unlimited; production: 1 to 150)
#RATE_LIMIT_QUESTIONS=5  # per client address ... (production: 1 to 5; FREE_RATE_LIMIT_QUESTIONS 1 to 30, WORKSPACE_CREATE_PER_DAY 1 to 3, UPLOADS_PER_HOUR 1 to 10)
#RATE_LIMIT_WINDOW_SECONDS=600  # production: at least 600
#LLM_ANSWER_MAX_TOKENS=2400
#TURNSTILE_SITE_KEY=     # optional Cloudflare Turnstile bot gate
#TURNSTILE_SECRET_KEY=
#TURNSTILE_REQUIRED=true  # fail closed once the widget exists (docs/RUNBOOK.md); production refuses to start without it and the secret (on Fly it is a fly.toml [env] entry, not a secret)
#READ_RATE_LIMIT_PER_MINUTE=120  # production: 1 to 120
# Address hashing (M5a I3): the per-address windows and the query ledger store an HMAC of the client address, never
# the address. Production REFUSES TO START without IP_HASH_PEPPER set to at least 32 bytes (a Fly secret, pushed by
# scripts/push_fly_secrets.py). Generate one of 48+ random bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotate ONLY on exposure: it resets every window and breaks correlation with older rows. Bump IP_HASH_VERSION with
# it: each ledger row stores the version of the pepper that made its hash. Empty outside production means a random
# pepper per process (windows and hashes start over at every restart).
IP_HASH_PEPPER=
#IP_HASH_VERSION=2       # the id of the pepper, at least 1 (0 marks a ledger row whose legacy hash was nulled)
# Async answer path (each must be 1 or more; the service refuses to start with a lower value):
#EMBED_SLOTS=1           # concurrent query embeddings (CPU-bound; bound it by the machine's cores)
#DB_THREAD_LIMIT=32      # worker threads for graph reads made on behalf of answer streams
#SEND_TIMEOUT_S=30       # a client that stops reading an answer stream is dropped after this many seconds
#LOOP_LAG_WARN_MS=100    # the event-loop monitor logs a stall longer than this many milliseconds
# Paid-ask admission state (M5a I4, docs/RUNBOOK.md "Paid-ask limits and the state backend"). Production REFUSES TO
# START with a cap raised past 150 asks a day, $10 a day, 20 asks per address a day or 4 in flight, or with a cap of 0
# (0 means "off" outside production), and without TURNSTILE_REQUIRED=true, TURNSTILE_SECRET_KEY and
# CLIENT_IP_HEADER=fly-client-ip. The windows and budgets below are pinned the same way (not looser than what runs today):
# CACHE_READ_BUDGET_PER_S at most 10, KILL_SWITCH_STALE_S at most 30. Check a deployment before you ship it:
#   uv run python -m scripts.check_env_fly   (docs/RUNBOOK.md "Pre-deploy check")
#STATE_BACKEND=inprocess              # inprocess = counters in memory, rows in Neo4j (live); neo4j = counters in Neo4j too (rollback)
#MAX_SPEND_USD_PER_DAY=10.0           # estimate-based spend cap per UTC day beside MAX_QUERIES_PER_DAY (0 = off)
#PAID_PER_IP_PER_DAY=20               # paid asks per client address per UTC day (0 = off)
#PAID_SPEND_SHARE_PER_IP_USD=1.32     # one address's share of the day's spend, in dollars: settled spend + running asks' estimates + this ask's estimate must stay within it (0 = off; production: above 0 and at most 1.32: seven full shares still leave room for a hybrid ask, so pausing live asks takes eight addresses, and the buyer demo's second agent ask fits; two hybrid asks at once from one address do not fit, and an agent ask needs the address's settled spend at or under about $0.30, a hybrid ask under about $0.61; docs/RUNBOOK.md "The per-address spend share")
#STATE_OP_TIMEOUT_S=1.0               # every state operation is bounded by this; past it the ask fails closed (0.1 to 10)
#STATE_CONNECTION_ACQUISITION_S=0.5   # ceiling on one connection attempt of the state driver (0.05 to 10)
#KILL_SWITCH_REFRESH_S=10             # how often the kill level is re-read from the database (at least 1)
#KILL_SWITCH_STALE_S=30               # a kill level older than this reads as "on"; must exceed the refresh period
#CACHE_READ_BUDGET_PER_S=10           # answer-cache reads per second for the whole process, before the bot check (at least 1)
#LEASE_TTL_S=60                       # a paid ask's lease that nobody renews expires after this (at least 1)
#LEASE_RENEW_S=15                     # lease renewal and sweep period; must be below LEASE_TTL_S
#DRAIN_TIMEOUT_S=240                  # how long a stop signal waits for running streams and uploads (1 to 254: the shutdown after it must fit Fly's 300 s kill timeout)
#MACHINE_ID=                          # id written on every ledger row; empty = Fly's FLY_MACHINE_ID, else the host name

# --- Staging switches: the load-test window's throwaway apps (deploy/staging/fly.stg.toml, scripts/staging.py) ---
# Each is staging only - refused in production: a production process REFUSES TO START with any of them set (and with a mock
# model or the staging database), so a value copied from a staging file stops the deploy (uv run python -m scripts.check_env_fly).
# Leave them all unset locally unless you run the mock LLM (tools/mockllm) against a local app: ENVIRONMENT=development allows them.
#TURNSTILE_STUB=false     # staging only - refused in production: the bot check accepts any non-empty token and never calls Cloudflare
#ORIGIN_AUTH_SECRET=      # staging only - refused in production: every request but GET /healthz must carry it in X-Origin-Auth (32+ bytes in staging)
#OPENAI_API_BASE=         # staging only - refused in production: send every openai/ model call here instead of OpenAI (an http(s) URL on a .internal host in staging)
# LiteLLM also reads these from the process environment itself, and a live call passes no api_base of its own, so a production
# process that holds any of them would send its model calls elsewhere: production REFUSES TO START with one set (any value, in
# fly.toml [env], a secret or the shell; an empty one is not a base). A developer may use them for a local gateway.
#OPENAI_BASE_URL=         # read BEFORE OPENAI_API_BASE for every openai/ call - refused in production
#ANTHROPIC_API_BASE=      # read for every anthropic/ (Sonnet) call - refused in production
#ANTHROPIC_BASE_URL=      # the other spelling of the same switch - refused in production
# ENVIRONMENT=staging additionally REQUIRES (and refuses to start without): NEO4J_URI on semigraph-neo4j-stg.internal, no
# ANTHROPIC_API_KEY, OPENAI_API_KEY starting with mock-, ANSWER_MODEL / ESCALATION_MODEL / AGENT_PLANNER_MODEL = openai/mock-<name>,
# FRESHNESS_ENABLED=false, CLIENT_IP_HEADER=x-test-client-ip (or fly-client-ip). scripts/staging.py generates the window's secrets.

# --- Agent (semigraph.agent, docs/v2/M3_AGENT_PLAN.md): an OPT-IN retrieval planner, strategy "agent". Off by default. ---
# Needs the `agent` extra (langgraph) in the image: uv sync --extra agent. The fixed hybrid path stays the default and the fallback.
#AGENT_ENABLED=false
#AGENT_PLANNER_MODEL=openai/gpt-6-luna    # plans the tool calls only; the answer still comes from ANSWER_MODEL / ESCALATION_MODEL
#AGENT_MAX_TOOL_CALLS=4
#AGENT_MAX_MODEL_CALLS=3
#AGENT_TIME_BUDGET_S=25                    # on expiry (or any planner failure) the plain hybrid retrieval answers

# --- Langfuse tracing (semigraph.serve.tracing): OFF unless all three are set AND the langfuse package is installed ---
# pip install "langfuse>=4.14,<5". Sampled, fail-open; a trace carries lengths, counts, ids, tool and model names, tokens, cost and latency,
# never the question, the answer, an address, a header or a key. Needs the owner's sign-off (the page then shows a privacy line).
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_HOST=
#LANGFUSE_SAMPLE_RATE=0.1
#LANGFUSE_HASH_SALT=     # empty = a random salt per process; set it to group repeated questions across restarts.
                          # Must be >= 32 chars or it is ignored (a short/guessable salt lets the trace recipient dictionary-
                          # recover a hashed question). Generate a safe one with: python -c "import secrets; print(secrets.token_hex(32))"

# --- Freshness monitor (semigraph.serve.monitor, docs/v2/M4_PLAN.md 4.1): checks EDGAR + the Federal Register, never ingests ---
# Needs SEC_USER_AGENT; without it the monitor reports configured:false and idles.
#FRESHNESS_ENABLED=false
#FRESHNESS_POLL_HOURS=6
#FRESHNESS_BOOT_DELAY_S=300

# --- Upload workspaces (docs/v2/M4_PLAN.md 3 + 4.2): private, 24 h, deletable; Turnstile fails CLOSED for uploads ---
#UPLOADS_ENABLED=false            # false = every workspace route answers 503
#WORKSPACE_TTL_HOURS=24
#UPLOAD_MAX_PAGES=30              # per version
#UPLOAD_MAX_TOKENS=16000          # per version (embedding time sets this cap)
#UPLOAD_MAX_WORKSPACE_TOKENS=48000
#MAX_UPLOADS_PER_DAY=40           # global
#UPLOAD_EMBED_TIMEOUT_S=1200
