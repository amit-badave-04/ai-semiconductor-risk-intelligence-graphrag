# Secrets must NEVER enter image layers.
.env
.env.*
!.env.example
# The three rules above are anchored at the context root. The web stage copies all of web/, and Vite inlines every VITE_* value
# of a web/.env* into the public bundle, so the same rules apply at every depth (the last matching rule wins).
**/.env
**/.env.*
!**/.env.example
# VCS, envs, caches, data lake, notebooks, docs — not needed to serve
.git
.venv
.pytest_cache
__pycache__
**/__pycache__
*.pyc
data/
notebooks/
docs/
dist/
web/node_modules
web/dist
web/coverage
web/test-results
web/playwright-report
web/lighthouse-out
tests/
models/
deploy/neo4j/
.claude
Dockerfile
.dockerignore
